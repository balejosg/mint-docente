#!/bin/bash
# Lanza OpenCode Desktop con las herramientas de documentos (entorno Python)
# en el PATH del agente. La carpeta de trabajo la abre el propio OpenCode
# (Documentos/Proyecto predeterminado, icono «Aula» del escritorio).
export PATH="/opt/docente-py/bin:$PATH"
cd "$HOME" || exit 1
exec /opt/OpenCode/ai.opencode "$@"
