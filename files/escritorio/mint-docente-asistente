#!/bin/bash
# Asistente de primer arranque: conecta una cuenta de IA a OpenCode.
# También se usa desde el menú: «Cambiar cuenta de IA».
TITULO="Mint Docente"
ESTADO="$HOME/.config/mint-docente"
mkdir -p "$ESTADO"
AVISO=""
pgrep -f /opt/OpenCode/ai.opencode >/dev/null && \
  AVISO="\n\nCierra OpenCode y vuelve a abrirlo para usar la nueva cuenta."

# GitHub Copilot: inicio de sesión con código, sin terminal.
copilot() {
  local log pid code i
  log=$(mktemp)
  opencode auth login github-copilot --method device \
    --answer deploymentType=github.com >"$log" 2>&1 &
  pid=$!
  for i in $(seq 60); do   # hasta 30 s para recibir el código de GitHub
    code=$(grep -aoE 'code: [A-Z0-9]{4}-[A-Z0-9]{4}' "$log" | head -1 | cut -d' ' -f2)
    [ -n "$code" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  if [ -z "$code" ]; then
    kill "$pid" 2>/dev/null; rm -f "$log"
    zenity --error --title="$TITULO" --width=420 --text=\
"No se ha podido contactar con GitHub.\n\nComprueba que hay conexión a Internet e inténtalo de nuevo."
    return 1
  fi
  printf '%s' "$code" | xclip -selection clipboard 2>/dev/null
  if command -v firefox >/dev/null; then
    firefox --new-window https://github.com/login/device >/dev/null 2>&1 &
  else
    xdg-open https://github.com/login/device >/dev/null 2>&1 &
  fi
  # Que la ventana del código quede por encima del navegador.
  ( sleep 3; wmctrl -r "GitHub Copilot" -b add,above ) &
  # Ventana con el código. Lee de un descriptor que controlamos: al cerrarlo
  # (fin de la entrada) se cierra sola. No se le envía nada: cualquier línea
  # "#…" sustituiría el texto.
  local zp
  exec 3> >(zenity --progress --pulsate --auto-close --title="$TITULO — GitHub Copilot" \
    --width=520 --cancel-label="Cancelar" --text=\
"<big>Tu código es:  <b><tt>$code</tt></b></big>   (ya está copiado)

1. En el navegador que se acaba de abrir, inicia sesión en <b>GitHub</b>
    con tu cuenta de docente.
2. Pega el código (Ctrl+V) y pulsa <b>Continue</b> y luego <b>Authorize</b>.
3. Vuelve aquí: esta ventana se cerrará sola.

Si el navegador no se abre, entra en <b>github.com/login/device</b>")
  zp=$!
  # Esperar a que GitHub confirme (termina el login) o a que se cancele la ventana.
  while kill -0 "$pid" 2>/dev/null && kill -0 "$zp" 2>/dev/null; do sleep 1; done
  exec 3>&-                                   # cierra la ventana si sigue abierta
  kill -0 "$pid" 2>/dev/null && kill "$pid"   # cancelado: abandonar el login
  wait "$pid" 2>/dev/null
  rm -f "$log"
}

conectar() { # id-proveedor nombre-visible
  local id="$1" nombre="$2"
  if [ "$id" = github-copilot ]; then
    copilot
  else
    xfce4-terminal --title="Conectar $nombre" --hide-menubar --geometry=100x30 \
      -x /usr/local/bin/mint-docente-conectar "$id" "$nombre"
  fi
  if opencode auth list 2>/dev/null | grep -qi -- "${id%%-*}"; then
    zenity --info --title="$TITULO" --width=420 \
      --text="<b>¡Listo!</b>\n\nTu cuenta de $nombre está conectada.$AVISO"
    return 0
  fi
  zenity --question --title="$TITULO" --width=420 \
    --ok-label="Reintentar" --cancel-label="Más tarde" \
    --text="No se ha podido confirmar la conexión con $nombre.\n\n¿Quieres intentarlo de nuevo?" \
    && conectar "$id" "$nombre"
}

zenity --info --title="$TITULO" --width=480 --ok-label="Empezar" --text=\
"<big><b>Te damos la bienvenida a Mint Docente</b></big>

Vas a trabajar con <b>OpenCode</b>, un asistente de IA que te ayuda a preparar temarios, actividades, rúbricas, exámenes y documentos en Word y PDF.

Antes de empezar, hay que conectarlo a tu cuenta de IA. Solo se hace una vez."

OPCION=$(zenity --list --radiolist --title="$TITULO" --width=520 --height=300 \
  --text="¿Qué cuenta quieres usar?" \
  --column="" --column="id" --column="Cuenta" --hide-column=2 --print-column=2 \
  TRUE  github-copilot "GitHub Copilot (recomendado para docentes)" \
  FALSE otro           "Otro proveedor de pago (Anthropic, OpenAI…)" \
  FALSE omitir         "Ahora no — lo haré más tarde") || OPCION=omitir

case "$OPCION" in
  github-copilot)
    conectar github-copilot "GitHub Copilot" ;;
  otro)
    P=$(zenity --list --title="$TITULO" --width=420 --height=300 \
      --text="Elige el proveedor:" --column="id" --column="Proveedor" \
      --hide-column=1 --print-column=1 \
      anthropic "Anthropic (Claude)" openai "OpenAI (ChatGPT)" \
      openrouter "OpenRouter" opencode "OpenCode Go / Zen")
    [ -n "$P" ] && conectar "$P" "$(echo "$P" | sed 's/^./\U&/')" ;;
  *)
    zenity --info --title="$TITULO" --width=420 --text=\
"Sin problema. Cuando quieras, abre el menú y busca <b>«Cambiar cuenta de IA»</b>." ;;
esac

touch "$ESTADO/asistente-hecho"
