def repo_mi_trabajo_en_github(login: str) -> bool:
    try:
        gh(["api", f"repos/{login}/{REPO_MI_TRABAJO}"])
    except ErrorGitHub as e:
        if http_estado(e) == 404:
            return False
        raise
    return True


def contar_archivos_sin_repo(carpeta: Path) -> int:
    """Archivos del Aula cuando aún no es un repositorio (sin Compartido/ ni metadatos)."""
    if not carpeta.is_dir():
        return 0
    n = 0
    for actual, dirs, archivos in os.walk(carpeta):
        if Path(actual) == carpeta:
            dirs[:] = [d for d in dirs if d not in ("Compartido", ".mint-docente", ".git")]
        n += len(archivos)
    return n


def mi_trabajo_estado(args):
    login = yo()["login"]
    en_github = repo_mi_trabajo_en_github(login)
    local = (aula() / ".git").is_dir()
    if not local:
        n = contar_archivos_sin_repo(aula())
    elif git(aula(), "remote", "get-url", "origin", comprobar=False).returncode == 0:
        n = pendientes(Espacio(aula()))
    else:                                            # repositorio sin remoto todavía
        n = len(nombres(git(aula(), "status", "--porcelain", "-z", "--untracked-files=all").stdout))
    salida({"en_github": en_github, "local": local, "pendientes": n})


def preparar_repo_aula(usuario: dict) -> None:
    """Crea en GitHub el repositorio de «Mi trabajo» y convierte el Aula en su copia local."""
    login = usuario["login"]
    if not repo_mi_trabajo_en_github(login):
        try:
            gh(["repo", "create", REPO_MI_TRABAJO, "--private",
                "--description", DESCRIPCION_MI_TRABAJO])
        except ErrorGitHub as e:
            if "already exists" not in str(e):
                raise
    carpeta = aula()
    carpeta.mkdir(parents=True, exist_ok=True)
    if not (carpeta / ".git").is_dir():
        git(carpeta, "init", "-q")
        git(carpeta, "symbolic-ref", "HEAD", "refs/heads/main")
    configurar_identidad(carpeta, usuario)
    url = f"{git_base()}/{login}/{REPO_MI_TRABAJO}.git"
    actual = git(carpeta, "remote", "get-url", "origin", comprobar=False)
    if actual.returncode != 0:
        git(carpeta, "remote", "add", "origin", url)
    elif actual.stdout.strip() != url:
        git(carpeta, "remote", "set-url", "origin", url)
    gitignore = carpeta / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text(GITIGNORE + "Compartido/\n", encoding="utf-8")
    elif "Compartido/" not in gitignore.read_text(encoding="utf-8").splitlines():
        with open(gitignore, "a", encoding="utf-8") as f:
            f.write("\nCompartido/\n")
    # «Mi trabajo» guardado desde otro equipo y aún no traído aquí: no se mezcla
    # a ciegas; primero hay que traerlo.
    esp = Espacio(carpeta)
    fetch(esp)
    if hay_remoto(esp) and git(carpeta, "merge-base", "HEAD", REMOTO,
                               comprobar=False).returncode != 0:
        raise Error(MENSAJES["mi_trabajo_en_otro_equipo"])


def escribir_json(ruta: Path, datos) -> None:
    ruta.write_text(json.dumps(datos, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def escribir_metadatos() -> None:
    d = datos_mi_trabajo()
    d.mkdir(parents=True, exist_ok=True)
    escribir_json(d / "espacios.json",
                  [{"nombre": e.nombre, "propietario": e.propietario, "repo": e.repo}
                   for e in espacios_locales()])
    escribir_json(d / "skills-companeros.json",
                  [{"skill": p.name, "espacio": o.get("espacio"), "ruta": o.get("ruta"),
                    "version": o.get("version")} for p, o in skills_en_uso()])
    propias = d / "skills-propias"
    shutil.rmtree(propias, ignore_errors=True)
    propias.mkdir()
    origen = skills_dir()
    if origen.is_dir():
        for p in sorted(origen.iterdir()):
            if p.name.startswith(".") or not p.is_dir() or (p / ".origen").exists():
                continue
            shutil.copytree(p, propias / p.name, symlinks=False, ignore_dangling_symlinks=True,
                            ignore=shutil.ignore_patterns(".git"))


def mi_trabajo_guardar(args):
    if not args:
        raise Error(MENSAJES["uso"])
    descripcion = " ".join(args).strip() or "Cambios"
    preparar_repo_aula(yo())
    escribir_metadatos()
    total = guardar_repo(aula(), descripcion, grandes="excluir")
    total["espacios"] = []
    for esp in espacios_locales():
        if pendientes(esp) == 0:
            continue
        try:
            res = guardar_repo(esp, descripcion)
        except (SinSesion, SinConexion):
            raise
        except Error as e:
            raise Error(MENSAJES["espacio_sin_guardar"].format(esp.nombre, e))
        total["espacios"].append({"nombre": esp.nombre, **res})
    salida(total)


