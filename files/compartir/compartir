def invitaciones_recibidas() -> list[dict]:
    lista = gh_json(["api", "user/repository_invitations"]) or []
    return [i for i in lista
            if (i["repository"].get("description") or "").startswith(DESCRIPCION_REPO)]


def nombre_espacio(repo: dict) -> str:
    """Nombre legible del espacio: el que se le dio al crearlo (va en la descripción)."""
    desc = repo.get("description") or ""
    nombre = desc.removeprefix(DESCRIPCION_REPO).lstrip(": ").strip()
    nombre = re.sub(r"[/\\\0]", "-", nombre).strip(". ")
    return nombre or repo["name"]


def cmd_invitaciones(args):
    salida([{"id": i["id"], "espacio": nombre_espacio(i["repository"]), "de": i["inviter"]["login"]}
            for i in invitaciones_recibidas()])


def cmd_aceptar(args):
    """aceptar <id> acepta una invitación; aceptar <propietario>/<repo> vuelve a
    descargar un espacio ya aceptado (por ejemplo, si se borró la carpeta)."""
    if len(args) != 1:
        raise Error(MENSAJES["uso"])
    if re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", args[0]):
        try:
            repo = gh_json(["api", f"repos/{args[0]}"])
        except ErrorGitHub as e:
            if http_estado(e) == 404:
                raise Error(MENSAJES["sin_acceso_espacio"])
            raise
        if not (repo.get("description") or "").startswith(DESCRIPCION_REPO):
            raise Error(MENSAJES["invitacion_no_existe"])
    else:
        if not args[0].isdigit():
            raise Error(MENSAJES["uso"])
        inv = next((i for i in invitaciones_recibidas() if str(i["id"]) == args[0]), None)
        if inv is None:
            raise Error(MENSAJES["invitacion_no_existe"])
        gh(["api", "-X", "PATCH", f"user/repository_invitations/{inv['id']}"])
        repo = inv["repository"]
    propietario = repo["owner"]["login"]
    nombre = nombre_espacio(repo)
    if (raiz() / nombre).exists():
        nombre = f"{nombre} (de {propietario})"
    if (raiz() / nombre).exists():
        raise Error(MENSAJES["ya_existe"].format(nombre))
    try:
        clonar(propietario, repo["name"], raiz() / nombre, yo())
    except Error as e:
        if isinstance(e, SinSesion):
            raise
        raise type(e)(MENSAJES["aceptado_sin_copia"].format(f"{propietario}/{repo['name']}"))
    salida({"espacio": nombre})


def cmd_usar(args):
    if len(args) != 2:
        raise Error(MENSAJES["uso"])
    esp = espacio(args[0])
    ruta = os.path.normpath(args[1].strip()).strip("/")
    origen_dir = esp.ruta / ruta
    campos = leer_frontmatter(origen_dir / "SKILL.md")
    nombre = campos.get("name", "")
    if not campos.get("description") or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", nombre) \
            or not origen_dir.resolve().is_relative_to(esp.ruta.resolve()):
        raise Error(MENSAJES["skill_invalida"].format(ruta))
    if nombre in skills_sistema():
        raise Error(MENSAJES["skill_ocupada"].format(nombre))
    destino = skills_dir() / nombre
    if destino.exists() or destino.is_symlink():
        try:
            previo = json.loads((destino / ".origen").read_text())
        except (OSError, json.JSONDecodeError):
            previo = {}
        if previo.get("espacio") != esp.nombre or previo.get("ruta") != ruta:
            raise Error(MENSAJES["skill_ocupada"].format(nombre))
        shutil.rmtree(destino)
    destino.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(origen_dir, destino, symlinks=False,
                    ignore=shutil.ignore_patterns(".git", ".origen"))
    version = version_skill(esp, ruta)
    (destino / ".origen").write_text(json.dumps(
        {"espacio": esp.nombre, "ruta": ruta, "version": version}, ensure_ascii=False))
    salida({"skill": nombre, "origen": f"{esp.nombre}/{ruta}", "version": version})


