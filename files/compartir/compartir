#!/usr/bin/python3
"""compartir — espacios compartidos entre docentes sobre GitHub.

El agente de Mint Docente usa esta orden en lugar de git y gh. Cada espacio es
un repositorio privado de la cuenta personal del docente, clonado en
<carpeta de trabajo>/Compartido/<nombre>. Nunca se pierde un archivo: si dos
docentes cambian lo mismo, se guardan las dos versiones.

Salida: JSON en stdout. Errores: una línea en español en stderr.
Códigos: 0 bien · 1 error explicado · 3 sin sesión de GitHub · 4 sin conexión.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

# ---------------------------------------------------------------- mensajes
MENSAJES = {
    "sin_sesion": "No estás conectado a GitHub. Abre «Conectar GitHub para compartir» "
                  "en el menú (o pídeselo al asistente) y vuelve a intentarlo.",
