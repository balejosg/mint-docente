# ---------------------------------------------------------------- entorno
def raiz() -> Path:
    if os.environ.get("COMPARTIR_RAIZ"):
        return Path(os.environ["COMPARTIR_RAIZ"])
    try:
        docs = subprocess.run(["xdg-user-dir", "DOCUMENTS"], capture_output=True,
                              text=True).stdout.strip()
    except OSError:
        docs = ""
    if not docs or docs == str(Path.home()):
        docs = str(Path.home() / "Documentos")
    return Path(docs) / "Proyecto predeterminado" / "Compartido"


def aula() -> Path:
    """Carpeta de trabajo del docente (el Aula): la que contiene Compartido/."""
    return raiz().parent


def datos_mi_trabajo() -> Path:
    """Metadatos de «Mi trabajo»: espacios, skills de compañeros y skills propias."""
    return aula() / ".mint-docente"


def git_base() -> str:
    return os.environ.get("COMPARTIR_GIT_BASE", "https://github.com").rstrip("/")


def salida(datos) -> None:
    print(json.dumps(datos, ensure_ascii=False))


# ---------------------------------------------------------------- gh
def gh(args: list[str]) -> str:
    """Ejecuta gh y devuelve stdout. Traduce los errores a excepciones."""
    entorno = {**os.environ, "GH_NO_UPDATE_NOTIFIER": "1", "GH_PROMPT_DISABLED": "1"}
    try:
        r = subprocess.run([os.environ.get("COMPARTIR_GH", "gh"), *args],
                           capture_output=True, text=True, env=entorno, timeout=TIEMPO_MAX)
    except subprocess.TimeoutExpired:
        raise SinConexion(MENSAJES["sin_conexion_gh"])
    except OSError:
        raise ErrorGitHub(MENSAJES["github"].format("no está instalada la orden gh"))
    if r.returncode == 0:
        return r.stdout
    err = r.stderr.strip()
    if r.returncode == 4 or "HTTP 401" in err or "gh auth login" in err:
        raise SinSesion()
    if re.search(r"error connecting|could not resolve|timeout|network is unreachable", err, re.I):
        raise SinConexion(MENSAJES["sin_conexion_gh"])
    raise ErrorGitHub(err.splitlines()[-1] if err else f"gh terminó con {r.returncode}")


def gh_json(args: list[str]):
    texto = gh(args)
    return json.loads(texto) if texto.strip() else None


def http_estado(e: ErrorGitHub) -> int | None:
    m = re.search(r"HTTP (\d{3})", str(e))
    return int(m.group(1)) if m else None


def yo() -> dict:
    return gh_json(["api", "user"])


# ---------------------------------------------------------------- git
def ultima_linea(texto: str) -> str:
    lineas = texto.strip().splitlines()
    return lineas[-1] if lineas else "error desconocido"


def git(ruta: Path, *args: str, comprobar=True) -> subprocess.CompletedProcess:
    entorno = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C"}
    # Si la red se queda colgada a mitad, git aborta en vez de esperar sin fin.
    try:
        r = subprocess.run(["git", "-c", "core.quotepath=off", "-c", "http.lowSpeedLimit=1000",
                            "-c", "http.lowSpeedTime=20", "-C", str(ruta), *args],
                           capture_output=True, text=True, env=entorno, timeout=TIEMPO_MAX)
    except subprocess.TimeoutExpired:
        raise SinConexion(MENSAJES["sin_conexion"])
    if comprobar and r.returncode != 0:
        raise Error(MENSAJES["git"].format(ultima_linea(r.stderr or r.stdout)))
    return r


def error_de_red(r: subprocess.CompletedProcess) -> Error:
    err = r.stderr
    if re.search(r"Authentication failed|could not read Username|HTTP 401|"
                 r"terminal prompts disabled", err, re.I):
        return SinSesion()
    if re.search(r"not found|does not appear to be a git repository|HTTP 40[34]|"
                 r"Permission to .* denied", err, re.I):
        return Error(MENSAJES["sin_acceso_espacio"])
    return SinConexion(MENSAJES["sin_conexion"])


def slug(nombre: str) -> str:
    s = unicodedata.normalize("NFKD", nombre)
    s = "".join(c for c in s if not unicodedata.combining(c)).lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s


class Espacio:
    def __init__(self, ruta: Path):
        self.ruta = ruta
        self.nombre = ruta.name
        url = git(ruta, "remote", "get-url", "origin").stdout.strip()
        partes = url.rstrip("/").removesuffix(".git").split("/")
        self.propietario, self.repo = partes[-2], partes[-1]

    @property
    def completo(self) -> str:
        return f"{self.propietario}/{self.repo}"

    @property
    def usuario(self) -> str:
        r = git(self.ruta, "config", "compartir.usuario", comprobar=False)
        return r.stdout.strip() or git(self.ruta, "config", "user.name").stdout.strip()


def nombre_valido(nombre: str) -> bool:
    return bool(nombre) and not re.search(r"[/\\\0]", nombre) and not nombre.startswith(".")


def espacio(nombre: str) -> Espacio:
    if not nombre_valido(nombre):
        raise ErrorGitHub(MENSAJES["no_existe"].format(nombre))
    ruta = raiz() / nombre
    if not (ruta / ".git").is_dir():
        raise ErrorGitHub(MENSAJES["no_existe"].format(nombre))
    return Espacio(ruta)


def espacios_locales() -> list[Espacio]:
    if not raiz().is_dir():
        return []
    return [Espacio(p) for p in sorted(raiz().iterdir()) if (p / ".git").is_dir()]


def configurar_identidad(ruta: Path, usuario: dict) -> None:
    git(ruta, "config", "user.name", usuario.get("name") or usuario["login"])
    git(ruta, "config", "user.email",
        f"{usuario['id']}+{usuario['login']}@users.noreply.github.com")
    git(ruta, "config", "compartir.usuario", usuario["login"])


def clonar(propietario: str, repo: str, destino: Path, usuario: dict) -> None:
    destino.parent.mkdir(parents=True, exist_ok=True)
    r = git(destino.parent, "clone", "-q", f"{git_base()}/{propietario}/{repo}.git", str(destino),
            comprobar=False)
    if r.returncode != 0:
        raise error_de_red(r)
    configurar_identidad(destino, usuario)


def hay_remoto(esp: Espacio) -> bool:
    return git(esp.ruta, "rev-parse", "--verify", "-q", REMOTO, comprobar=False).returncode == 0


def nombres(salida_git: str) -> list[str]:
    return [n for n in salida_git.split("\0") if n]


def fetch(esp: Espacio) -> None:
    r = git(esp.ruta, "fetch", "-q", "origin", comprobar=False)
    if r.returncode != 0:
        raise error_de_red(r)


def nombre_version(ruta: Path, archivo: str, usuario: str) -> str:
    p = Path(archivo)
    base = p.stem if p.suffix else p.name
    n = 1
    while True:
        extra = "" if n == 1 else f" {n}"
        candidato = str(p.with_name(f"{base} (versión de {usuario}){extra}{p.suffix}"))
        if not (ruta / candidato).exists():
            return candidato
        n += 1


def escribir_etapa(esp: Espacio, etapa: int, archivo: str, destino: str) -> None:
    contenido = subprocess.run(["git", "-C", str(esp.ruta), "show", f":{etapa}:{archivo}"],
                               capture_output=True, check=True).stdout
    if (esp.ruta / destino).is_dir():
        raise Error(MENSAJES["mezcla"].format(destino))
    (esp.ruta / destino).parent.mkdir(parents=True, exist_ok=True)
    (esp.ruta / destino).write_bytes(contenido)


def mezclar(esp: Espacio) -> dict:
    """Mezcla origin/main en HEAD sin perder nada. Devuelve nuevos/mezclados/dos_versiones."""
    res = {"nuevos": [], "mezclados": [], "dos_versiones": []}
    if not hay_remoto(esp):
        return res
    if git(esp.ruta, "merge-base", "--is-ancestor", REMOTO, "HEAD",
           comprobar=False).returncode == 0:
        return res                                   # nada nuevo en GitHub
    base = git(esp.ruta, "merge-base", "HEAD", REMOTO).stdout.strip()
    suyos = set(nombres(git(esp.ruta, "diff", "-z", "--name-only", base, REMOTO).stdout))
    mios = set(nombres(git(esp.ruta, "diff", "-z", "--name-only", base, "HEAD").stdout))
    res["nuevos"] = sorted(nombres(git(esp.ruta, "diff", "-z", "--name-only",
                                       "--diff-filter=AMR", base, REMOTO).stdout))
    r = git(esp.ruta, "merge", "-q", "--no-edit", REMOTO, comprobar=False)
    conflictos = set()
    if r.returncode != 0:
        archivo = ""
        try:
            etapas: dict[str, set[int]] = {}
            for linea in nombres(git(esp.ruta, "ls-files", "-u", "-z").stdout):
                meta, nombre = linea.split("\t", 1)
                etapas.setdefault(nombre, set()).add(int(meta.split()[2]))
            if not etapas:
                raise Error(MENSAJES["mezcla"].format(ultima_linea(r.stderr or r.stdout)))
            for archivo, e in sorted(etapas.items()):
                conflictos.add(archivo)
                if 2 in e and 3 in e:                # cambiado en los dos lados
                    copia = nombre_version(esp.ruta, archivo, esp.usuario)
                    escribir_etapa(esp, 3, archivo, archivo)
                    escribir_etapa(esp, 2, archivo, copia)
                    git(esp.ruta, "add", "--", archivo, copia)
                    res["dos_versiones"].append([archivo, copia])
                elif 3 in e or 2 in e:               # solo queda un lado: se conserva
                    escribir_etapa(esp, 3 if 3 in e else 2, archivo, archivo)
                    git(esp.ruta, "add", "--", archivo)
                else:                                # nadie lo conserva (p. ej. renombrado)
                    git(esp.ruta, "rm", "-q", "--cached", "--", archivo)
                    (esp.ruta / archivo).unlink(missing_ok=True)
            if git(esp.ruta, "diff", "--name-only", "--diff-filter=U").stdout.strip():
                raise Error(MENSAJES["mezcla"].format(archivo))
            git(esp.ruta, "commit", "-q", "--no-edit")
        except Exception as ex:
            git(esp.ruta, "merge", "--abort", comprobar=False)
            if isinstance(ex, Error):
                raise
            raise Error(MENSAJES["mezcla"].format(archivo))
    res["mezclados"] = sorted((suyos & mios) - conflictos)
    return res


def escapar_exclude(archivo: str) -> str:
    """Ruta literal, anclada a la raíz, para .git/info/exclude."""
    texto = re.sub(r"([\\*?\[])", r"\\\1", archivo)
    if texto.endswith(" "):
        texto = texto[:-1] + "\\ "
    return "/" + texto


def excluir(ruta: Path, archivos: list[str]) -> None:
    with open(ruta / ".git" / "info" / "exclude", "a", encoding="utf-8") as f:
        for a in archivos:
            f.write(escapar_exclude(a) + "\n")


def comprobar_salientes(esp: Espacio, grandes: str = "error") -> list[str]:
    """Rechaza claves secretas en lo que se va a subir. Los archivos enormes dan
    error (grandes="error") o se sacan del commit y se excluyen (grandes="excluir");
    devuelve los excluidos."""
    excluidos = []
    if hay_remoto(esp):
        base = git(esp.ruta, "merge-base", "HEAD", REMOTO).stdout.strip()
        cambiados = nombres(git(esp.ruta, "diff", "-z", "--cached", "--name-only",
                                "--diff-filter=AMR", base).stdout)
    else:
        cambiados = nombres(git(esp.ruta, "ls-files", "-z", "--cached").stdout)
    for archivo in cambiados:
        ruta = esp.ruta / archivo
        if not ruta.is_file():
            continue
        if ruta.stat().st_size > LIMITE_BYTES:
            if grandes != "excluir":
                raise Error(MENSAJES["grande"].format(archivo))
            sacar_del_indice(esp.ruta, archivo)
            excluir(esp.ruta, [archivo])
            excluidos.append(archivo)
            continue
        with open(ruta, "rb") as f:
            datos = f.read(2 * 1024 * 1024)
        if b"\0" in datos[:8000]:
            continue                                 # binario
        for n, linea in enumerate(datos.decode("utf-8", "ignore").splitlines(), 1):
            if any(p.search(linea) for p in PATRONES_CLAVE):
                raise Error(MENSAJES["clave"].format(f"{archivo}:{n}"))
    return excluidos


def skills_dir() -> Path:
    return Path(os.environ.get("COMPARTIR_SKILLS", Path.home() / ".config" / "opencode" / "skills"))


def skills_sistema() -> set[str]:
    """Nombres de las skills que trae la imagen: una skill compartida no puede suplantarlas."""
    d = Path(os.environ.get("COMPARTIR_SKILLS_SISTEMA", "/usr/share/mint-docente/skills"))
    if not d.is_dir():
        return set()
    res = set()
    for p in d.iterdir():
        res.add(p.name)
        res.add(leer_frontmatter(p / "SKILL.md").get("name", p.name))
    return res


def leer_frontmatter(skill_md: Path) -> dict:
    try:
        texto = skill_md.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return {}
    m = re.match(r"---\s*\n(.*?)\n---\s*(\n|$)", texto, re.S)
    if not m:
        return {}
    campos = {}
    for linea in m.group(1).splitlines():
        if ":" in linea and not linea.startswith((" ", "\t")):
            k, v = linea.split(":", 1)
            campos[k.strip()] = v.strip().strip("'\"")
    return campos


def version_skill(esp: Espacio, ruta: str) -> str:
    r = git(esp.ruta, "rev-parse", "-q", "--verify", f"HEAD:{ruta}", comprobar=False)
    return r.stdout.strip() or "sin-guardar"


def skills_en_uso() -> list[tuple[Path, dict]]:
    d = skills_dir()
    if not d.is_dir():
        return []
    res = []
    for p in sorted(d.iterdir()):
        origen = p / ".origen"
        if origen.is_file():
            try:
                res.append((p, json.loads(origen.read_text())))
            except json.JSONDecodeError:
                pass
    return res


def novedades_skills(esp: Espacio) -> list[str]:
    return [p.name for p, o in skills_en_uso()
            if o.get("espacio") == esp.nombre and version_skill(esp, o["ruta"]) != o.get("version")]


def validar_usuario(u: str) -> None:
    if "@" in u:
        raise Error(MENSAJES["correo"])
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})", u):
        raise Error(MENSAJES["usuario_raro"].format(u))


def exigir_propietario(esp: Espacio, accion: str) -> None:
    if yo()["login"].lower() != esp.propietario.lower():
        raise Error(MENSAJES["solo_propietario"].format(esp.propietario, accion))


# ---------------------------------------------------------------- órdenes
def pendientes(esp: Espacio) -> int:
    """Cambios locales sin guardar más commits que aún no están en GitHub."""
    sucio = len(nombres(git(esp.ruta, "status", "--porcelain", "-z",
                            "--untracked-files=all").stdout))
    adelante = 0
    if hay_remoto(esp):
        adelante = int(git(esp.ruta, "rev-list", "--count",
                           f"{REMOTO}..HEAD").stdout.strip() or 0)
    return sucio + adelante


def cmd_estado(args):
    usuario = yo()["login"]
    lista = []
    for esp in espacios_locales():
        lista.append({"nombre": esp.nombre, "propietario": esp.propietario,
                      "pendientes": pendientes(esp)})
    salida({"usuario": usuario, "espacios": lista})


def cmd_crear(args):
    if len(args) != 1:
        raise Error(MENSAJES["uso"])
    nombre = args[0].strip()
    s = slug(nombre)
    if not nombre or not s:
        raise Error(MENSAJES["nombre_vacio"])
    if not nombre_valido(nombre):
        raise Error(MENSAJES["nombre_raro"])
    destino = raiz() / nombre
    if destino.exists():
        raise Error(MENSAJES["ya_existe"].format(nombre))
    usuario = yo()
    try:
        gh(["repo", "create", s, "--private", "--description", f"{DESCRIPCION_REPO}: {nombre}"])
    except ErrorGitHub as e:
        if "already exists" in str(e):
            raise Error(MENSAJES["ya_existe_github"].format(s))
        raise
    gh(["repo", "edit", f"{usuario['login']}/{s}", "--add-topic", TEMA])
    clonar(usuario["login"], s, destino, usuario)
    git(destino, "symbolic-ref", "HEAD", "refs/heads/main")
    (destino / ".gitignore").write_text(GITIGNORE)
    git(destino, "add", ".gitignore")
    git(destino, "commit", "-q", "-m", f"Espacio «{nombre}» creado")
    r = git(destino, "push", "-q", "-u", "origin", "main", comprobar=False)
    if r.returncode != 0:
        raise error_de_red(r)
    salida({"espacio": nombre, "propietario": usuario["login"]})


def limpiar_mezcla(esp: Espacio) -> None:
    """Deshace una mezcla que quedó a medias (proceso interrumpido)."""
    if (esp.ruta / ".git" / "MERGE_HEAD").exists():
        if git(esp.ruta, "merge", "--abort", comprobar=False).returncode != 0:
            for f in ("MERGE_HEAD", "MERGE_MSG", "MERGE_MODE"):
                (esp.ruta / ".git" / f).unlink(missing_ok=True)
            git(esp.ruta, "reset", "-q")


def excluir_grandes_previos(ruta: Path) -> tuple[list[str], list[str]]:
    """Antes de `git add`, busca los archivos nuevos o cambiados de más de
    LIMITE_BYTES (así git ni siquiera los copia). Los nuevos van a
    .git/info/exclude (que se reescribe). Devuelve (todos, ya_seguidos): los ya
    seguidos se dejan fuera del `git add` para conservar su versión anterior."""
    (ruta / ".git" / "info").mkdir(parents=True, exist_ok=True)
    (ruta / ".git" / "info" / "exclude").write_text(EXCLUDE_AULA, encoding="utf-8")
    candidatos = set(nombres(git(ruta, "ls-files", "-z", "--others", "--exclude-standard").stdout))
    modificados = set(nombres(git(ruta, "ls-files", "-z", "--modified").stdout))
    grandes = sorted(a for a in candidatos | modificados
                     if (ruta / a).is_file() and (ruta / a).stat().st_size > LIMITE_BYTES)
    excluir(ruta, [a for a in grandes if a in candidatos])
    return grandes, [a for a in grandes if a in modificados]


def sacar_del_indice(ruta: Path, archivo: str) -> None:
    """Deja `archivo` en el índice como está en HEAD: si ya estaba guardado se
    conserva la versión anterior (nunca se sube un borrado); si es nuevo, se quita."""
    if git(ruta, "cat-file", "-e", f"HEAD:{archivo}", comprobar=False).returncode == 0:
        git(ruta, "reset", "-q", "--", archivo)
    else:
        git(ruta, "rm", "-q", "--cached", "--", archivo)


def preparar_local(esp: Espacio, mensaje: str, grandes: str = "error") -> list[str]:
    """Junta en un único commit local todo lo que aún no está en GitHub.
    Devuelve los archivos grandes que se han dejado fuera (grandes="excluir")."""
    limpiar_mezcla(esp)
    excluidos, seguidos = excluir_grandes_previos(esp.ruta) if grandes == "excluir" else ([], [])
    git(esp.ruta, "add", "-A", "--", ":(top)", *(f":(top,exclude,literal){a}" for a in seguidos))
    if hay_remoto(esp):
        # Solo se juntan los commits propios: el punto de partida es lo último
        # que este equipo mezcló de GitHub, no origin/main (que puede ir por delante).
        base = git(esp.ruta, "merge-base", "HEAD", REMOTO).stdout.strip()
        git(esp.ruta, "reset", "-q", "--soft", base)
    excluidos += comprobar_salientes(esp, grandes)
    if git(esp.ruta, "diff", "--cached", "--quiet", comprobar=False).returncode != 0:
        git(esp.ruta, "commit", "-q", "-m", mensaje)
    return sorted(set(excluidos))


def guardar_repo(esp_o_ruta: "Espacio | Path", descripcion: str, grandes: str = "error") -> dict:
    """Guarda un repositorio (un espacio o el Aula): commit local, mezcla con lo
    de GitHub sin perder nada y subida. Con grandes="excluir", los archivos de
    más de LIMITE_BYTES no se suben y se devuelven en "no_subidos"."""
    esp = esp_o_ruta if isinstance(esp_o_ruta, Espacio) else Espacio(Path(esp_o_ruta))
    excluidos = preparar_local(esp, descripcion, grandes)
    total = {"subidos": [], "mezclados": [], "dos_versiones": []}
    for _ in range(REINTENTOS + 1):
        fetch(esp)
        res = mezclar(esp)
        total["mezclados"] += res["mezclados"]
        total["dos_versiones"] += res["dos_versiones"]
        subidos = nombres(git(esp.ruta, "diff", "-z", "--name-only", REMOTO, "HEAD").stdout) \
            if hay_remoto(esp) else nombres(git(esp.ruta, "ls-files", "-z").stdout)
        if not subidos and hay_remoto(esp) and \
                git(esp.ruta, "rev-parse", "HEAD").stdout == git(esp.ruta, "rev-parse", REMOTO).stdout:
            break
        r = git(esp.ruta, "push", "-q", "origin", "HEAD:main", comprobar=False)
        if r.returncode == 0:
            total["subidos"] = sorted(subidos)
            git(esp.ruta, "fetch", "-q", "origin", comprobar=False)
            break
        if not re.search(r"\[rejected\].*\((fetch first|non-fast-forward)\)", r.stderr):
            raise error_de_red(r)
    else:
        raise Error(MENSAJES["git"].format("otros compañeros están guardando a la vez; "
                                           "inténtalo de nuevo en un momento"))
    if grandes == "excluir":
        total["no_subidos"] = [{"archivo": a, "motivo": "grande"} for a in excluidos]
    return total


